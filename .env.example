---

## 📄 **ARCHIVO 2: .env.example**

```env
# ============================================================
# CONFIGURACIÓN DE ENTORNO - Django ERP POS
# ============================================================
# Copia este archivo a .env y actualiza los valores
# IMPORTANTE: NUNCA commits .env a Git (ya está en .gitignore)
# ============================================================

# ============================================================
# DJANGO SETTINGS
# ============================================================

# Ambiente: local, development, production
ENVIRONMENT=local

# Clave secreta de Django (genera una única y segura)
# Para generar: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-tu-clave-secreta-aqui-cambiar-en-produccion

# Debug mode (True en desarrollo, False en producción)
DEBUG=True

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# BASE DE DATOS - DESARROLLO (SQLite)
# ============================================================
# SQLite se usa automáticamente en desarrollo
# Archivo: db.sqlite3

# ============================================================
# BASE DE DATOS - PRODUCCIÓN (PostgreSQL/MySQL)
# ============================================================
# Descomenta y configura según tu BD en producción

# PostgreSQL en Render.com (recomendado)
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd
DATABASE_URL=postgres://usuario:password@localhost:5432/myerpposdj

# O configurar manualmente:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=nombre_bd
# DATABASE_USER=usuario
# DATABASE_PASSWORD=contraseña
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ============================================================
# SEGURIDAD
# ============================================================

# SSL/HTTPS en producción
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================================
# EMAIL (Opcional - para notificaciones)
# ============================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# ============================================================
# RENDER.COM (Si usas Render para deploy)
# ============================================================

# URL de la base de datos (Render la proporciona)
# DATABASE_URL=postgresql://...

# ============================================================
# LOGGING (Opcional)
# ============================================================

LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# ============================================================
# OTROS
# ============================================================

# Zona horaria
TIME_ZONE=America/Lima

# Idioma
LANGUAGE_CODE=es-pe

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. En producción (Render), configura variables en el panel
# 2. Genera una nueva SECRET_KEY para producción
# 3. DEBUG=False en producción
# 4. ALLOWED_HOSTS incluye tu dominio en producción
# 5. Usa contraseñas fuertes para DATABASE_PASSWORD
# ============================================================

# Django
SECRET_KEY=cambia-esto-en-produccion
DEBUG=True
ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local con docker-compose
DATABASE_URL=postgres://myerpposdj:myerpposdj@db:5432/myerpposdj

# Redis cache
REDIS_URL=redis://redis:6379/1

# Sentry / observabilidad
SENTRY_DSN=

# Render deploy automático
# Configurar como GitHub Secret: RENDER_DEPLOY_HOOK_URL
